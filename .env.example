POSTGRES_DB=dnf_leader
POSTGRES_USER=dnf
POSTGRES_PASSWORD=dnf-local-only
DATABASE_URL=postgresql+psycopg://dnf:dnf-local-only@localhost:5432/dnf_leader
CONTAINER_DATABASE_URL=postgresql+psycopg://dnf:dnf-local-only@db:5432/dnf_leader
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SOLVER_TIME_LIMIT_SECONDS=10
SOLVER_RANDOM_SEED=42
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# 可选：容器启动时自动创建首个 Owner；密码至少 10 位，生产环境必须替换。
BOOTSTRAP_OWNER_USERNAME=admin
BOOTSTRAP_OWNER_PASSWORD=change-me-now
