# Copy to .env.production and replace every example value before deployment.
PUBLIC_DOMAIN=dnf.example.com
POSTGRES_DB=dnf_leader
POSTGRES_USER=dnf
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode reserved characters in the password used below.
CONTAINER_DATABASE_URL=postgresql+psycopg://dnf:replace-with-a-long-random-database-password@db:5432/dnf_leader
ENVIRONMENT=production
CORS_ORIGINS=https://dnf.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_SOURCE_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCK_SECONDS=900
EDIT_LOCK_LEASE_SECONDS=90
EDIT_LOCK_HEARTBEAT_SECONDS=30
SOLVER_TIME_LIMIT_SECONDS=10
SOLVER_RANDOM_SEED=42
# Optional. Keep disabled until a DeepSeek API key has been provisioned.
NATURAL_LANGUAGE_RULES_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
RULE_PROMPT_VERSION=schedule-rules-v1
NATURAL_LANGUAGE_RULE_MAX_CHARS=2000
NATURAL_LANGUAGE_RULE_RATE_LIMIT_REQUESTS=10
NATURAL_LANGUAGE_RULE_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_OWNER_USERNAME=admin
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-long-random-owner-password
VITE_SHOW_DEV_LOGIN=false
